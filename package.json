{
  "name": "dsh-message-toolbar",
  "version": "1.12.5",
  "description": "DSH message toolbar for in-session regeneration, model and answer switching, editing, deletion and bilingual translation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VicissitudeYW/dsh-message-toolbar.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "plugin.client.js",
    "cordis.patch.yml",
    "scripts/build-client.mjs",
    "scripts/sync-profile.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "message-edit",
    "regenerate",
    "switch-model",
    "translation",
    "version-tree"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "sync": "node scripts/build-client.mjs && node scripts/sync-profile.mjs",
    "prepack": "npm run build"
  }
}
